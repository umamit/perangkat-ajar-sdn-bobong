# ====================================================
# PERANGKAT AJAR SD NEGERI BOBONG - ENVIRONMENT TEMPLATE
# Copy ini ke .env.local atau pasang di Vercel Settings
# ====================================================

# 1. Supabase Cloud URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Client-side Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Supabase Service Role Key (Backend Server Key)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
